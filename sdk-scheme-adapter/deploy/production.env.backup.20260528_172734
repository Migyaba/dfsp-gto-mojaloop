# FSPID of this DFSP
DFSP_ID=mojaloop

# Multi-DFSP Mode: Set to false if you only manage one DFSP
# When false, DFSP_ID above is used for all requests
# When true, DFSP ID must be in URL path: /GTO/transfers, /AGF/transfers, etc.
MULTI_DFSP=true

# Secret used for generation and verification of secure ILP
# IMPORTANT: Changez cette valeur pour la production!
ILP_SECRET=Quaixohyaesahju3thivuiChai5cahng

# Expiry period in seconds for quote and transfers issued by the SDK
EXPIRY_SECONDS=60

# AUTO ACCEPT OPTIONS
AUTO_ACCEPT_QUOTES=true
AUTO_ACCEPT_PARTY=true
AUTO_ACCEPT_R2P_PARTY=true

# Forex behavior
USE_QUOTE_SOURCE_FSP_AS_TRANSFER_PAYEE_FSP=true

# ILP validation
CHECK_ILP=true

# Test features
ENABLE_TEST_FEATURES=false

# Expiry validation
REJECT_EXPIRED_QUOTE_RESPONSES=true
REJECT_TRANSFERS_ON_EXPIRED_QUOTES=true
REJECT_EXPIRED_TRANSFER_FULFILS=true

# Timeout for request processing
REQUEST_PROCESSING_TIMEOUT_SECONDS=30

# Transfer without quote
ALLOW_TRANSFER_WITHOUT_QUOTE=false

# Notification on fulfilled transfer
RESERVE_NOTIFICATION=true

# Resource API versions
RESOURCE_VERSIONS="transfers=1.1,participants=1.1,quotes=1.0"

# PM4ML Configuration
# MCM (Mojaloop Connection Manager) WebSocket URL
# IMPORTANT: PM4ML nécessite un serveur de management API local sur le port 4005
# Pour l'instant, on utilise les clés JWS locales
PM4ML_ENABLED=true
MGMT_API_WS_URL=10.42.0.148
MGMT_API_WS_PORT=4004

# Event handlers
ENABLE_FSPIOP_EVENT_HANDLER=false
ENABLE_BACKEND_EVENT_HANDLER=false

# Maximum payload limits
FSPIOP_API_SERVER_MAX_REQUEST_BYTES=209715200
BACKEND_API_SERVER_MAX_REQUEST_BYTES=209715200

# Supported Currencies
SUPPORTED_CURRENCIES="USD,XOF,EUR"





