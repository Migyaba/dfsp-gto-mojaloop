
# Port number that the inbound (Mojaloop API) HTTP server will listen on
INBOUND_LISTEN_PORT=4000

# Port number that the outbound (simplified DFSP outbound API) HTTP server will listen on
OUTBOUND_LISTEN_PORT=4001

# Test API port (si ENABLE_TEST_FEATURES est activé)
TEST_LISTEN_PORT=4002

# Management API port (pour PM4ML)
MGMT_API_LISTEN_PORT=4005

# Enable mutual TLS authentication
# IMPORTANT: mTLS est requis pour communiquer avec le hub Mojaloop
INBOUND_MUTUAL_TLS_ENABLED=false
OUTBOUND_MUTUAL_TLS_ENABLED=false

# Enable verification of incoming JWS signatures
VALIDATE_INBOUND_JWS=false
VALIDATE_INBOUND_PUT_PARTIES_JWS=false

# Enable signing of outgoing requests
JWS_SIGN=true
JWS_SIGN_PUT_PARTIES=true

# Path to JWS signing key (si JWS_SIGN=true)
# JWS_SIGNING_KEY_PATH=/opt/app/secrets/jwsSigningKey.key
# JWS_VERIFICATION_KEYS_DIRECTORY=/opt/app/secrets/jwsVerificationKeys

# Location of certs and key required for TLS/mTLS
# IN_CA_CERT_PATH=/opt/app/secrets/tls/ca.crt
# IN_SERVER_CERT_PATH=/opt/app/secrets/tls/server.crt
# IN_SERVER_KEY_PATH=/opt/app/secrets/tls/server.key

# OUT_CA_CERT_PATH=/opt/app/secrets/tls/ca.crt
# OUT_CLIENT_CERT_PATH=/opt/app/secrets/tls/client.pem
# OUT_CLIENT_KEY_PATH=/opt/app/secrets/tls/client_key.pem

# Logging configuration
LOG_INDENT=2
LOG_LEVEL=info

# REDIS CACHE CONNECTION
# Redis sera déployé localement avec docker-compose
CACHE_URL=redis://sdk-redis:6379

